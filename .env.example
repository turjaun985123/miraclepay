# MiraclePay v0.0.1 — environment configuration
#
# Copy this file to `.env` and replace every placeholder before running:
#   cp .env.example .env
#
# Never commit a real `.env` file. All secrets below are placeholders only.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the API and the worker.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# When running via docker-compose, the host is the service name `postgres`
# and this value is also used to derive the container's POSTGRES_PASSWORD.
DATABASE_URL=postgres://miraclepay:change-me@localhost:5432/miraclepay

# Password for the Postgres container in docker-compose
# (keep this in sync with the password inside DATABASE_URL).
POSTGRES_PASSWORD=change-me

# --- Redis (optional) ---------------------------------------------------------
# Redis connection string for caching / queues. Redis is optional in
# docker-compose (started with `--profile redis`); leave as-is if unused.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------------------------
# Secret used to sign JWT access tokens. Use a long random value in
# production, e.g. generated with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-secret

# --- Server -------------------------------------------------------------------
# Port the API listens on.
PORT=8080

# Public base URL the API is reachable at (used in links, callbacks and
# webhook payloads). Include the scheme, no trailing slash.
PUBLIC_API_URL=http://localhost:8080

# --- Initial admin --------------------------------------------------------------
# Seed admin account created on first boot if no admin exists yet.
# Change both values before first run in any real deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
