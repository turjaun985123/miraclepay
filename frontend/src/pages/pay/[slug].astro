---
// MiraclePay v0.0.1 — Public payment-link page (clean-room, original).
//
// Served from the static build, so the link slug is not known at
// build time: the page reads it client-side from the last segment of
// `window.location.pathname` (e.g. `/pay/coaching-session-a1b2c3`).
// It then loads the public link view with `publicLink` from the API
// client and, on submit, starts a payment with `payLink`.
//
// The single placeholder path below exists only so the static build
// emits this page; the host serves it for every `/pay/<slug>` URL and
// the real slug is picked up in the browser.
export function getStaticPaths() {
  return [{ params: { slug: 'pay' } }];
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout title="Pay">
  <main id="main" class="container pay-page">
    <div class="payer-top">
      <p class="wordmark">MiraclePay</p>
      <button id="lang-toggle" class="btn btn-small btn-ghost" type="button">বাংলা</button>
    </div>
    <ol class="steps" id="pay-steps" aria-label="Progress">
      <li data-step="1" aria-current="step"><span class="step-dot">1</span><span data-i18n="step_review">Review</span></li>
      <li data-step="2"><span class="step-dot">2</span><span data-i18n="step_pay">Pay</span></li>
      <li data-step="3"><span class="step-dot">3</span><span data-i18n="step_done">Confirmed</span></li>
    </ol>

    <p id="pay-loading" class="card muted" data-i18n="pay_loading">Loading payment link…</p>

    <section id="pay-error-card" class="card pay-error-card" hidden>
      <h1 data-i18n="pay_error_heading">This payment link can&rsquo;t be used</h1>
      <p id="pay-error-message" class="alert alert-error" role="alert"></p>
      <p class="muted small" data-i18n="pay_error_hint">
        The link may be inactive, expired, or fully used. Please ask the
        merchant for a fresh link.
      </p>
    </section>

    <section id="pay-card" class="card pay-card" hidden>
      <img id="pay-logo" class="pay-logo" alt="" hidden />
      <p id="pay-merchant" class="pay-merchant muted" hidden></p>
      <h1 id="pay-title">Payment</h1>
      <p id="pay-description" class="muted" hidden></p>
      <p id="pay-brand-message" class="pay-brand-message" hidden></p>

      <p id="pay-fixed-amount" class="pay-amount" hidden></p>

      <div class="field" id="fx-field" hidden>
        <label class="label" for="fx-currency">Display currency</label>
        <select class="input" id="fx-currency"></select>
        <p class="field-hint" id="fx-converted" hidden></p>
      </div>

      <form id="pay-form" novalidate>
        <div class="field" id="amount-field" hidden>
          <label class="label" for="amount" data-i18n="pay_amount">Amount</label>
          <input
            class="input"
            id="amount"
            name="amount"
            type="number"
            inputmode="decimal"
            min="0"
            step="0.01"
            placeholder="0.00"
          />
          <p class="field-hint" id="amount-hint"></p>
        </div>

        <div class="field" id="phone-field" hidden>
          <label class="label" for="customer-phone" data-i18n="pay_phone">Phone number</label>
          <input
            class="input"
            id="customer-phone"
            name="customer_phone"
            type="tel"
            autocomplete="tel"
            placeholder="01XXXXXXXXX"
          />
        </div>

        <div class="field" id="email-field" hidden>
          <label class="label" for="customer-email" data-i18n="pay_email">Email address</label>
          <input
            class="input"
            id="customer-email"
            name="customer_email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
          />
        </div>

        <fieldset class="field">
          <legend class="label" data-i18n="pay_with">Pay with</legend>
          <div class="gateway-grid">
            <label class="gateway-card"><input type="radio" name="gateway" value="bkash" checked /><span class="gateway-name">bKash</span><span class="gateway-hint">Send money</span></label>
            <label class="gateway-card"><input type="radio" name="gateway" value="nagad" /><span class="gateway-name">Nagad</span><span class="gateway-hint">Send money</span></label>
            <label class="gateway-card"><input type="radio" name="gateway" value="rocket" /><span class="gateway-name">Rocket</span><span class="gateway-hint">Send money</span></label>
            <label class="gateway-card"><input type="radio" name="gateway" value="upay" /><span class="gateway-name">Upay</span><span class="gateway-hint">Send money</span></label>
            <label class="gateway-card"><input type="radio" name="gateway" value="surecash" /><span class="gateway-name">SureCash</span><span class="gateway-hint">Send money</span></label>
            <label class="gateway-card"><input type="radio" name="gateway" value="manual" /><span class="gateway-name">Manual transfer</span><span class="gateway-hint">Bank or cash</span></label>
          </div>
        </fieldset>

        <p id="pay-form-error" class="alert alert-error" role="alert" hidden></p>

        <button id="pay-submit" class="btn pay-submit" type="submit" data-i18n="pay_now">
          Pay now
        </button>
      </form>
    </section>

    <p class="trust-row">
      <Icon name="lock" size={15} />
      <span>Secure payment by MiraclePay. Never share your wallet PIN.</span>
    </p>

    <section id="pay-success" class="card pay-success" hidden>
      <h1 data-i18n="pay_started">Payment started</h1>
      <p class="alert alert-success" data-i18n="pay_started_body">
        Your payment has been created and is waiting for the money to arrive.
      </p>
      <dl class="pay-details">
        <div>
          <dt data-i18n="pay_transaction_id">Transaction ID</dt>
          <dd><span class="copy-field"><code class="copy-value" id="success-transaction-id">—</code><button type="button" class="btn btn-small btn-ghost" id="copy-tx">Copy</button></span></dd>
        </div>
        <div>
          <dt data-i18n="pay_reference">Reference</dt>
          <dd><span class="copy-field"><code class="copy-value" id="success-reference">—</code><button type="button" class="btn btn-small btn-ghost" id="copy-ref2">Copy</button></span></dd>
        </div>
        <div>
          <dt data-i18n="pay_amount">Amount</dt>
          <dd id="success-amount">—</dd>
        </div>
      </dl>
      <p data-i18n="pay_finish_body">
        To finish, send the money with your chosen payment app and use the
        reference above exactly as shown. Once the payment SMS reaches the
        merchant, MiraclePay verifies it automatically — you don&rsquo;t need
        to upload a screenshot or do anything else on this page.
      </p>
      <p>
        <a id="success-track-link" class="btn btn-ghost" href="#" hidden>I've sent the money — track this payment</a>
      </p>
      <p class="muted small" data-i18n="pay_keep_note">
        Keep your transaction ID and reference until the payment is confirmed.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .pay-page {
    max-width: 560px;
  }

  .brand-line {
    margin: 0.5rem 0 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--brand-dark);
  }

  .pay-merchant {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pay-amount {
    margin: 0 0 1.25rem;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .pay-logo {
    max-height: 56px;
    max-width: 220px;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }
  .pay-brand-message {
    border-left: 3px solid var(--color-brand);
    padding-left: 0.6rem;
  }
  .pay-submit {
    width: 100%;
    padding: 0.75rem 1rem;
  }

  .pay-details {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .pay-details dt {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pay-details dd {
    margin: 0.125rem 0 0;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { apiFetch, checkoutDetails, formatMoney, payLink, publicLink } from '../../lib/api';
  import { applyI18n, getLang, otherLang, setLang, t, toggleLabel } from '../../lib/i18n';
  import { brandAccent, clearFieldError, copyText, fieldError } from '../../lib/ui';

  // Bangla/English toggle (Wave 22): static strings swap via
  // data-i18n; strings set below use t() so they follow the choice.
  const langToggle = document.getElementById('lang-toggle');
  function syncToggle(): void {
    if (langToggle) langToggle.textContent = toggleLabel(getLang());
  }
  langToggle?.addEventListener('click', () => {
    setLang(otherLang(getLang()));
    syncToggle();
    // The submit button's fixed-amount label is script-set; refresh.
    if (fixedAmountMinor !== null && submitButton) {
      submitButton.textContent = t('pay_now_amount', {
        amount: formatMoney(fixedAmountMinor, currency),
      });
    }
  });
  applyI18n();
  syncToggle();

  // The public endpoint returns the fields this page needs, but the
  // exact serialisation can carry the fixed amount either flat
  // (`amount_minor` + `currency`, as typed in the API client) or as a
  // nested money object (`amount: { amount_minor, currency }`).
  // Normalise both shapes here.
  interface PublicLinkShape {
    title?: string;
    description?: string | null;
    merchant_name?: string;
    branding?: {
      display_name?: string | null;
      brand_color?: string | null;
      logo_url?: string | null;
      checkout_message?: string | null;
    } | null;
    collect_phone?: boolean;
    collect_email?: boolean;
    amount_minor?: number | null;
    currency?: string;
    amount?: { amount_minor?: number; currency?: string } | null;
    [key: string]: unknown;
  }

  interface PayLinkResultShape {
    transaction_id?: string;
    id?: string;
    reference?: string;
    status?: string;
    [key: string]: unknown;
  }

  const loadingEl = document.getElementById('pay-loading');
  const errorCardEl = document.getElementById('pay-error-card');
  const errorMessageEl = document.getElementById('pay-error-message');
  const cardEl = document.getElementById('pay-card');
  const merchantEl = document.getElementById('pay-merchant');
  const titleEl = document.getElementById('pay-title');
  const descriptionEl = document.getElementById('pay-description');
  const fixedAmountEl = document.getElementById('pay-fixed-amount');
  const form = document.getElementById('pay-form') as HTMLFormElement | null;
  const amountFieldEl = document.getElementById('amount-field');
  const amountInput = document.getElementById('amount') as HTMLInputElement | null;
  const amountHintEl = document.getElementById('amount-hint');
  const phoneFieldEl = document.getElementById('phone-field');
  const phoneInput = document.getElementById(
    'customer-phone',
  ) as HTMLInputElement | null;
  const emailFieldEl = document.getElementById('email-field');
  const emailInput = document.getElementById(
    'customer-email',
  ) as HTMLInputElement | null;
  const gatewayValue = (): string =>
    (document.querySelector('input[name="gateway"]:checked') as HTMLInputElement | null)?.value ?? '';
  const stepEls = document.querySelectorAll('#pay-steps li');
  function setSteps(current: number): void {
    stepEls.forEach((li) => {
      const n = Number(li.getAttribute('data-step'));
      li.classList.toggle('done', n < current);
      if (n === current) li.setAttribute('aria-current', 'step');
      else li.removeAttribute('aria-current');
    });
  }
  document.getElementById('copy-tx')?.addEventListener('click', () => {
    const v = document.getElementById('success-transaction-id')?.textContent;
    if (v && v !== '—') void copyText(v);
  });
  document.getElementById('copy-ref2')?.addEventListener('click', () => {
    const v = document.getElementById('success-reference')?.textContent;
    if (v && v !== '—') void copyText(v);
  });
  const formErrorEl = document.getElementById('pay-form-error');
  const submitButton = document.getElementById(
    'pay-submit',
  ) as HTMLButtonElement | null;
  const successEl = document.getElementById('pay-success');
  const successTxEl = document.getElementById('success-transaction-id');
  const successRefEl = document.getElementById('success-reference');
  const successAmountEl = document.getElementById('success-amount');

  // Static output: the slug is the last non-empty path segment.
  const segments = window.location.pathname.split('/').filter(Boolean);
  const slug = decodeURIComponent(segments[segments.length - 1] ?? '');

  let fixedAmountMinor: number | null = null;
  let currency = 'BDT';
  let collectPhone = false;
  let collectEmail = false;

  // ── Display-currency conversion (Wave 98) ──────────────────────
  // Display only: the charged amount and currency never change.
  // Rates come from GET /api/v1/fx/rates → { base, rates: [{currency,
  // num, den}] } where num/den is units of the currency per 1 BDT, so
  // converted = amount * rate(to) / rate(from). The endpoint requires
  // auth, so for anonymous visitors the fetch fails and the selector
  // simply stays hidden.
  interface FxRateEntry {
    num: number;
    den: number;
  }
  const fxFieldEl = document.getElementById('fx-field');
  const fxSelect = document.getElementById('fx-currency') as HTMLSelectElement | null;
  const fxConvertedEl = document.getElementById('fx-converted');
  let fxRates: Map<string, FxRateEntry> | null = null;

  function payableMinor(): number | null {
    if (fixedAmountMinor !== null) return fixedAmountMinor;
    const major = Number(amountInput?.value ?? '');
    return Number.isFinite(major) && major > 0 ? Math.round(major * 100) : null;
  }

  function updateFxDisplay(): void {
    if (!fxRates || !fxSelect || !fxConvertedEl) return;
    const target = fxSelect.value;
    const amount = payableMinor();
    const from = fxRates.get(currency);
    const to = fxRates.get(target);
    if (!target || target === currency || amount === null || !from || !to) {
      fxConvertedEl.hidden = true;
      return;
    }
    const converted = Math.round(
      (amount * (to.num / to.den)) / (from.num / from.den),
    );
    fxConvertedEl.textContent = `≈ ${formatMoney(converted, target)} (display only — you will be charged ${formatMoney(amount, currency)})`;
    fxConvertedEl.hidden = false;
  }

  async function loadFxRates(): Promise<void> {
    try {
      const res = await apiFetch<{
        rates?: { currency?: unknown; num?: number; den?: number }[];
      }>('/api/v1/fx/rates');
      const rates = new Map<string, FxRateEntry>();
      for (const entry of res?.rates ?? []) {
        const code =
          typeof entry.currency === 'string'
            ? entry.currency
            : entry.currency && typeof entry.currency === 'object'
              ? String((entry.currency as { code?: unknown }).code ?? '')
              : '';
        if (code && typeof entry.num === 'number' && typeof entry.den === 'number' && entry.den !== 0) {
          rates.set(code.toUpperCase(), { num: entry.num, den: entry.den });
        }
      }
      if (rates.size < 2 || !fxSelect) return;
      fxRates = rates;
      fxSelect.replaceChildren();
      for (const code of rates.keys()) {
        const opt = document.createElement('option');
        opt.value = code;
        opt.textContent = code;
        fxSelect.append(opt);
      }
      fxSelect.value = currency;
      if (fxFieldEl) fxFieldEl.hidden = false;
      updateFxDisplay();
    } catch {
      // No rates available (e.g. anonymous visitor): no selector.
      if (fxFieldEl) fxFieldEl.hidden = true;
    }
  }

  fxSelect?.addEventListener('change', updateFxDisplay);
  amountInput?.addEventListener('input', updateFxDisplay);

  function showLoadError(message: string): void {
    if (loadingEl) loadingEl.hidden = true;
    if (cardEl) cardEl.hidden = true;
    if (errorMessageEl) errorMessageEl.textContent = message;
    if (errorCardEl) errorCardEl.hidden = false;
  }

  function showFormError(message: string): void {
    if (!formErrorEl) return;
    formErrorEl.textContent = message;
    formErrorEl.hidden = false;
  }

  function hideFormError(): void {
    if (!formErrorEl) return;
    formErrorEl.textContent = '';
    formErrorEl.hidden = true;
  }

  async function loadLink(): Promise<void> {
    if (!slug) {
      showLoadError(t('pay_err_no_link'));
      return;
    }

    try {
      const link = (await publicLink(slug)) as unknown as PublicLinkShape;

      const nestedMinor = link.amount?.amount_minor;
      fixedAmountMinor =
        typeof link.amount_minor === 'number'
          ? link.amount_minor
          : typeof nestedMinor === 'number'
            ? nestedMinor
            : null;
      currency = (link.currency ?? link.amount?.currency ?? 'BDT').toUpperCase();
      collectPhone = link.collect_phone === true;
      collectEmail = link.collect_email === true;

      if (titleEl) titleEl.textContent = link.title ?? t('pay_title_default');
      document.title = `MiraclePay — Pay — ${link.title ?? 'Payment'}`;

      if (merchantEl && link.merchant_name) {
        merchantEl.textContent = link.merchant_name;
        merchantEl.hidden = false;
      }

      // Per-merchant branding (Wave 37): display name wins over
      // the legal name, the logo shows when set, the checkout
      // message renders as-is (textContent — never HTML), and the
      // brand colour accents the pay button. The colour is
      // validated server-side as #rrggbb before it can be stored.
      const branding = link.branding ?? null;
      if (branding) {
        if (merchantEl && branding.display_name) {
          merchantEl.textContent = branding.display_name;
          merchantEl.hidden = false;
        }
        const logoEl = document.getElementById('pay-logo') as HTMLImageElement | null;
        if (logoEl && branding.logo_url) {
          logoEl.src = branding.logo_url;
          logoEl.alt = branding.display_name ?? link.merchant_name ?? '';
          logoEl.hidden = false;
        }
        const brandMsgEl = document.getElementById('pay-brand-message');
        if (brandMsgEl && branding.checkout_message) {
          brandMsgEl.textContent = branding.checkout_message;
          brandMsgEl.hidden = false;
        }
        const accent = brandAccent(branding.brand_color);
        if (accent) {
          document.documentElement.style.setProperty('--color-brand', accent);
          if (submitButton) submitButton.style.background = accent;
        }
      }

      if (descriptionEl && link.description) {
        descriptionEl.textContent = link.description;
        descriptionEl.hidden = false;
      }

      if (fixedAmountMinor !== null) {
        // Fixed-amount link: show the amount, no amount input.
        if (fixedAmountEl) {
          fixedAmountEl.textContent = formatMoney(fixedAmountMinor, currency);
          fixedAmountEl.hidden = false;
        }
        if (submitButton) {
          submitButton.textContent = t('pay_now_amount', {
            amount: formatMoney(fixedAmountMinor, currency),
          });
        }
      } else {
        // Open-amount link: the customer types the amount in major
        // units (e.g. taka); it is converted to minor units on submit.
        if (amountFieldEl) amountFieldEl.hidden = false;
        if (amountInput) amountInput.required = true;
        if (amountHintEl) {
          amountHintEl.textContent = t('pay_amount_hint', { currency });
        }
      }

      if (collectPhone) {
        if (phoneFieldEl) phoneFieldEl.hidden = false;
        if (phoneInput) phoneInput.required = true;
      }

      if (collectEmail) {
        if (emailFieldEl) emailFieldEl.hidden = false;
        if (emailInput) emailInput.required = true;
      }

      if (loadingEl) loadingEl.hidden = true;
      if (cardEl) cardEl.hidden = false;
      void loadFxRates();
    } catch (error) {
      // Inactive, expired, exhausted or unknown links surface here as
      // the API's error message (e.g. "link not available").
      showLoadError(error instanceof Error ? error.message : t('pay_err_load'));
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    hideFormError();

    let amountMinor = fixedAmountMinor;
    if (amountMinor === null) {
      const major = Number(amountInput?.value ?? '');
      if (!Number.isFinite(major) || major <= 0) {
        showFormError(t('pay_err_amount'));
        return;
      }
      amountMinor = Math.round(major * 100);
    }

    const customerPhone = phoneInput?.value.trim() ?? '';
    if (collectPhone) {
      const digits = customerPhone.replace(/[\s-]/g, '');
      if (!/^(\+?880|0)1[3-9]\d{8}$/.test(digits) && !/^\d{6,15}$/.test(digits)) {
        if (phoneInput) fieldError(phoneInput, t('pay_err_phone'));
        phoneInput?.focus();
        return;
      }
    }

    const customerEmail = emailInput?.value.trim() ?? '';
    if (collectEmail && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(customerEmail)) {
      if (emailInput) fieldError(emailInput, t('pay_err_email'));
      emailInput?.focus();
      return;
    }

    const gateway = gatewayValue();
    if (!gateway) {
      showFormError(t('pay_err_gateway'));
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.dataset.label = submitButton.textContent ?? '';
      submitButton.textContent = 'Starting…';
    }

    try {
      const result = (await payLink(slug, {
        amount_minor: amountMinor,
        customer_phone: customerPhone || undefined,
        customer_email: customerEmail || undefined,
        gateway,
      })) as unknown as PayLinkResultShape;

      const transactionId = result.transaction_id ?? result.id ?? '';
      const reference = result.reference ?? slug;

      if (successTxEl) successTxEl.textContent = transactionId || '—';
      if (successRefEl) successRefEl.textContent = reference;
      if (successAmountEl) {
        successAmountEl.textContent = formatMoney(amountMinor, currency);
      }

      setSteps(3);
      if (cardEl) cardEl.hidden = true;
      if (successEl) successEl.hidden = false;
      // Review 180 P0/P1: the success state is a dead end today.
      // Deep-link to the hosted checkout tracker for this
      // transaction and poll it so confirmation lands here too.
      const trackLink = document.getElementById('success-track-link') as HTMLAnchorElement | null;
      if (trackLink && transactionId) {
        trackLink.href = `/checkout/${encodeURIComponent(transactionId)}`;
        trackLink.hidden = false;
      }
      if (transactionId) {
        let tries = 0;
        const timer = window.setInterval(() => {
          tries += 1;
          if (tries > 30) { window.clearInterval(timer); return; }
          void checkoutDetails(transactionId).then((d) => {
            const st = String((d as { status?: string }).status ?? '').toLowerCase();
            if (st === 'completed' || st === 'paid' || st === 'success') {
              window.clearInterval(timer);
              const body = successEl?.querySelector('[data-i18n="pay_started_body"]');
              if (body) body.textContent = 'Payment confirmed — the merchant has been notified. Thank you!';
            }
          }).catch(() => { /* keep polling */ });
        }, 6000);
      }
      // Respect reduced-motion preferences (Wave 23).
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      successEl?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    } catch (error) {
      showFormError(error instanceof Error ? error.message : t('pay_err_start'));
      if (submitButton) {
        submitButton.disabled = false;
        if (submitButton.dataset.label) submitButton.textContent = submitButton.dataset.label;
      }
    }
  });

  amountInput?.addEventListener('input', () => {
    if (fixedAmountMinor === null && submitButton) {
      const minor = payableMinor();
      submitButton.textContent = minor !== null
        ? t('pay_now_amount', { amount: formatMoney(minor, currency) })
        : t('pay_now');
    }
  });
  phoneInput?.addEventListener('input', () => clearFieldError(phoneInput));
  emailInput?.addEventListener('input', () => clearFieldError(emailInput));
  amountInput?.addEventListener('input', () => clearFieldError(amountInput));

  void loadLink();
</script>
