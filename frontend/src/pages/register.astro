---
// MiraclePay — Registration page (Waves 161/163: shared auth shell).
// First-run flow: create account, auto sign-in, land on the dashboard
// where the first merchant is created.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Create account — MiraclePay">
  <main id="main" class="auth-wrap">
    <section class="auth-card" aria-labelledby="register-heading">
      <p class="auth-brand"><img src="/favicon.svg" alt="" width="28" height="28" /> MiraclePay</p>
      <h1 id="register-heading" data-i18n="auth_register_heading">Create your account</h1>
      <p class="auth-sub">
        Register once, then create your merchant from the dashboard to
        start accepting payments.
      </p>

      <form id="register-form" novalidate>
        <div class="field">
          <label class="label" for="name" data-i18n="auth_name">Full name</label>
          <input class="input" id="name" name="name" type="text" autocomplete="name" placeholder="Ayesha Rahman" required />
        </div>

        <div class="field">
          <label class="label" for="email" data-i18n="auth_email">Email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>

        <div class="field">
          <label class="label" for="password" data-i18n="auth_password">Password</label>
          <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="8" aria-describedby="password-hint" required />
          <p class="field-hint" id="password-hint">At least 8 characters, with a number.</p>
        </div>

        <p id="form-error" class="alert alert-error" role="alert" hidden></p>

        <button id="submit-button" type="submit" class="btn btn-block">Create account</button>
      </form>

      <p class="auth-switch">
        Already have an account? <a href="/login">Sign in</a>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import { applyI18n } from "../lib/i18n";
  applyI18n();
  import { register, login, setToken } from '../lib/api';

  const form = document.getElementById('register-form');
  const errorEl = document.getElementById('form-error');
  const submitButton = document.getElementById('submit-button');

  function showError(message) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const password = String(data.get('password') ?? '');

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.textContent = 'Creating account…';
    }

    try {
      // Create the account, then sign in straight away so the new
      // user lands on the dashboard without re-typing credentials.
      await register(name, email, password);
      const session = await login(email, password);

      const token =
        typeof session === 'string'
          ? session
          : (session?.token ?? session?.access_token);
      if (!token) {
        throw new Error('Registration succeeded but sign-in returned no token. Please sign in.');
      }
      setToken(token);

      // First run: the dashboard is where the new user creates
      // their first merchant.
      window.location.href = '/dashboard';
    } catch (err) {
      showError(
        err instanceof Error
          ? err.message
          : 'Could not create your account. Please try again.',
      );
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.textContent = 'Create account';
      }
    }
  });
</script>
