---
// MiraclePay — Login page (Waves 161–162: shared auth shell on tokens).
// Client-side auth: `login` from the API client, token via `setToken`,
// redirect to the dashboard. Existing-token note offers a shortcut.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Log in">
  <main id="main" class="auth-wrap">
    <section class="auth-card" aria-labelledby="login-heading">
      <p class="auth-brand"><img src="/favicon.svg" alt="" width="28" height="28" /> MiraclePay</p>
      <h1 id="login-heading" data-i18n="auth_login_heading">Log in to MiraclePay</h1>
      <p class="auth-sub">Access your merchant dashboard, payments and gateways.</p>

      <p id="logged-in-note" class="alert alert-success" hidden>
        You are logged in — <a href="/dashboard">go to dashboard</a>
      </p>

      <form id="login-form" novalidate>
        <div class="field">
          <label class="label" for="email" data-i18n="auth_email">Email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>

        <div class="field">
          <label class="label" for="password" data-i18n="auth_password">Password</label>
          <input class="input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Your password" required />
          <p class="field-hint"><a href="/forgot-password">Forgot your password?</a></p>
        </div>

        <div class="field" id="totp-field" hidden>
          <label class="label" for="totp-code" data-i18n="auth_totp">Two-factor code</label>
          <input class="input" id="totp-code" name="totp_code" type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit code from your authenticator app" />
          <p class="field-hint">This account has two-factor authentication enabled.</p>
        </div>

        <p id="login-error" class="alert alert-error" role="alert" hidden></p>

        <button id="login-submit" type="submit" class="btn btn-block">Log in</button>
      </form>

      <p class="auth-switch">
        Don&rsquo;t have an account? <a href="/register">Create one</a>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import { applyI18n } from "../lib/i18n";
  applyI18n();
  import { getToken, login, setToken } from '../lib/api';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const passwordInput = document.getElementById('password') as HTMLInputElement | null;
  const errorEl = document.getElementById('login-error') as HTMLParagraphElement | null;
  const submitButton = document.getElementById('login-submit') as HTMLButtonElement | null;
  const loggedInNote = document.getElementById('logged-in-note') as HTMLParagraphElement | null;

  if (getToken() && loggedInNote) {
    loggedInNote.hidden = false;
  }

  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }
  function hideError(): void {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    hideError();

    const email = emailInput?.value.trim() ?? '';
    const password = passwordInput?.value ?? '';

    if (!email || !password) {
      showError('Please enter your email and password.');
      (!email ? emailInput : passwordInput)?.focus();
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Logging in…';
    }

    const totpField = document.getElementById('totp-field');
    const totpInput = document.getElementById('totp-code') as HTMLInputElement | null;
    const totpCode = totpInput?.value.trim() || undefined;

    try {
      const result: unknown = await login(email, password, totpCode);
      const token =
        typeof result === 'string'
          ? result
          : (result as { token?: string } | null)?.token;

      if (!token) {
        throw new Error('Login succeeded but no token was returned.');
      }

      setToken(token);
      window.location.href = '/dashboard';
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : 'Login failed. Please check your email and password and try again.';
      // Wave 26: the API answers 401 `totp_required` / `totp_invalid`
      // for 2FA accounts — reveal the code field and explain.
      if (message.includes('totp_required') || message.includes('totp_invalid')) {
        if (totpField) totpField.hidden = false;
        totpInput?.focus();
        showError(
          message.includes('totp_required')
            ? 'This account has two-factor authentication enabled. Enter the 6-digit code from your authenticator app.'
            : 'That two-factor code did not verify. Please try the current code from your authenticator app.',
        );
      } else {
        showError(message);
      }
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Log in';
      }
    }
  });
</script>
