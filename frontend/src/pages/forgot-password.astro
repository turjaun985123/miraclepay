---
// MiraclePay — Forgot password (Wave 166). Two steps on the shared
// auth shell: request a reset token by email, then confirm with the
// token + a new password (backend Wave 88 endpoints).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reset password — MiraclePay">
  <main id="main" class="auth-wrap">
    <section class="auth-card" aria-labelledby="reset-heading">
      <p class="auth-brand"><img src="/favicon.svg" alt="" width="28" height="28" /> MiraclePay</p>
      <h1 id="reset-heading">Reset your password</h1>
      <p class="auth-sub">Enter your account email and we will send a reset token (valid for 1 hour).</p>

      <form id="request-form" novalidate>
        <div class="field">
          <label class="label" for="email">Email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>
        <p id="request-ok" class="alert alert-success" role="status" hidden>
          If that account exists, a reset token is on its way. Paste it below with your new password.
        </p>
        <p id="request-error" class="alert alert-error" role="alert" hidden></p>
        <button id="request-submit" type="submit" class="btn btn-block">Send reset token</button>
      </form>

      <hr class="auth-divider" />

      <form id="confirm-form" novalidate>
        <div class="field">
          <label class="label" for="token">Reset token</label>
          <input class="input" id="token" name="token" type="text" autocomplete="one-time-code" placeholder="Token from the email" required />
        </div>
        <div class="field">
          <label class="label" for="new-password">New password</label>
          <input class="input" id="new-password" name="new_password" type="password" autocomplete="new-password" minlength="8" aria-describedby="pw-hint" required />
          <p class="field-hint" id="pw-hint">At least 8 characters, with a number. Resetting ends all existing sessions.</p>
        </div>
        <p id="confirm-ok" class="alert alert-success" role="status" hidden>
          Password updated — <a href="/login">sign in with your new password</a>.
        </p>
        <p id="confirm-error" class="alert alert-error" role="alert" hidden></p>
        <button id="confirm-submit" type="submit" class="btn btn-block">Set new password</button>
      </form>

      <p class="auth-switch">Remembered it? <a href="/login">Back to sign in</a></p>
    </section>
  </main>
</BaseLayout>

<script>
  import { passwordResetRequest, passwordResetConfirm } from '../lib/api';

  const show = (id, msg) => { const el = document.getElementById(id); if (el) { if (msg !== undefined) el.textContent = msg; el.hidden = false; } };
  const hide = (id) => { const el = document.getElementById(id); if (el) el.hidden = true; };

  document.getElementById('request-form')?.addEventListener('submit', async (e) => {
    e.preventDefault(); hide('request-error'); hide('request-ok');
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const btn = document.getElementById('request-submit') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Sending…';
    try { await passwordResetRequest(email); show('request-ok'); }
    catch (err) { show('request-error', err instanceof Error ? err.message : 'Could not send the reset email.'); }
    btn.disabled = false; btn.textContent = 'Send reset token';
  });

  document.getElementById('confirm-form')?.addEventListener('submit', async (e) => {
    e.preventDefault(); hide('confirm-error'); hide('confirm-ok');
    const token = (document.getElementById('token') as HTMLInputElement).value.trim();
    const pw = (document.getElementById('new-password') as HTMLInputElement).value;
    const btn = document.getElementById('confirm-submit') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Updating…';
    try { await passwordResetConfirm(token, pw); show('confirm-ok'); }
    catch (err) { show('confirm-error', err instanceof Error ? err.message : 'That token did not verify — it may have expired. Request a new one above.'); }
    btn.disabled = false; btn.textContent = 'Set new password';
  });
</script>
