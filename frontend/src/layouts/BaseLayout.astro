---
// MiraclePay — BaseLayout (Waves 152–158 design system)
// Tokens live in src/styles/tokens.css (imported once here); this
// layout owns the shared component classes. Pages consume tokens
// and these classes — no page-level colour/spacing literals.

import "../styles/tokens.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dashboard",
  description = "MiraclePay — self-hosted payment automation for gateways, checkout, webhooks and verification.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>MiraclePay — {title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--color-bg); color: var(--color-ink);
        font-family: var(--font-sans); font-size: 16px; line-height: var(--lh-body);
      }
      h1, h2, h3, h4 { line-height: var(--lh-tight); margin: 0 0 0.5em; font-weight: 700; }
      h1 { font-size: var(--text-3xl); } h2 { font-size: var(--text-xl); } h3 { font-size: var(--text-lg); }
      p { margin: 0 0 1em; }
      a { color: var(--color-brand-hover); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code, .mono { font-family: var(--font-mono); font-size: 0.9em; }
      :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
      .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      .skip-link {
        position: absolute; left: 1rem; top: -4rem; z-index: var(--z-nav);
        background: var(--color-surface); color: var(--color-ink);
        padding: var(--space-2) var(--space-4); border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm); transition: top var(--motion-fast) var(--ease-out);
      }
      .skip-link:focus { top: 1rem; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          transition-duration: 0.01ms !important; animation-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
        .skeleton { animation: none !important; }
      }

      /* Layout */
      .container { width: 100%; max-width: var(--container); margin-inline: auto; padding: var(--space-6) var(--space-5) var(--space-12); }
      .container-narrow { max-width: var(--container-narrow); }
      .grid { display: grid; gap: var(--gap-grid); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .stack { display: grid; gap: var(--space-4); }
      .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
      .muted { color: var(--color-muted); } .small { font-size: var(--text-base-sm); }
      .page-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-5); }
      .page-header h1 { margin-bottom: var(--space-1); }
      .page-header .page-sub { color: var(--color-muted); margin: 0; }

      /* Surfaces */
      .card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: var(--pad-card); }
      .stat { display: grid; gap: var(--space-1); }
      .stat .stat-label { color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
      .stat .stat-value { font-size: var(--text-3xl); font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; }
      .stat .stat-hint { color: var(--color-muted); font-size: var(--text-base-sm); }

      /* Buttons — 44px target floor (WCAG); .btn-sm is the dense-table exception */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
        min-height: var(--target-min); padding: var(--space-2_5) var(--space-4);
        border: 1px solid transparent; border-radius: var(--radius-md);
        background: var(--color-brand); color: var(--color-on-brand);
        font: inherit; font-size: var(--text-body); font-weight: 600;
        cursor: pointer; white-space: nowrap;
        transition: background var(--motion-fast) var(--ease-out), opacity var(--motion-fast) var(--ease-out);
      }
      .btn:hover { background: var(--color-brand-hover); text-decoration: none; }
      .btn:disabled { opacity: 0.55; cursor: not-allowed; }
      .btn-ghost { background: var(--color-surface); color: var(--color-ink); border-color: var(--color-border-strong); }
      .btn-ghost:hover { background: var(--color-bg); }
      .btn-danger { background: var(--color-danger); color: var(--p-white); }
      .btn-danger:hover { background: var(--color-danger-hover); }
      .btn-sm, .btn-small { min-height: 2.25rem; padding: var(--space-1_5) var(--space-3); font-size: var(--text-base-sm); }
      .btn-block { width: 100%; }

      /* Forms — control boundaries use border-strong (≥3:1); focus ring is visible */
      .label { display: block; margin-bottom: var(--space-1_5); font-size: var(--text-base-sm); font-weight: 600; }
      .input, select.input, textarea.input {
        display: block; width: 100%; min-height: var(--target-min); padding: var(--space-2_5) var(--space-3);
        border: 1px solid var(--color-border-strong); border-radius: var(--radius-md);
        background: var(--color-surface); color: var(--color-ink); font: inherit; font-size: var(--text-body);
      }
      .input::placeholder { color: var(--color-muted); }
      .input:focus { border-color: var(--color-brand); outline: 2px solid var(--color-focus); outline-offset: 1px; }
      .input[aria-invalid="true"] { border-color: var(--color-danger); }
      .field { margin-bottom: var(--space-4); }
      .field-hint { margin-top: var(--space-1_5); color: var(--color-muted); font-size: var(--text-sm); }
      .field-error { margin-top: var(--space-1_5); color: var(--color-danger-text); font-size: var(--text-sm); font-weight: 600; }

      /* Tables — money columns: .num (right, tabular) */
      .table { width: 100%; border-collapse: collapse; font-size: var(--text-body); }
      .table th, .table td { padding: var(--space-2_5) var(--space-3); text-align: left; border-bottom: 1px solid var(--color-border); vertical-align: middle; }
      .table th { color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; }
      .table tbody tr:hover { background: var(--color-surface-sunken); }
      .table .num { text-align: right; font-variant-numeric: tabular-nums; }
      .table th.num { text-align: right; }
      .table-wrap { overflow-x: auto; }
      .pagination { display: flex; align-items: center; gap: var(--space-3); justify-content: flex-end; padding-top: var(--space-3); }

      /* Badges — text colours are AA on their soft backgrounds */
      .badge { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-0_5) var(--space-2_5); border-radius: var(--radius-full); background: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border); font-size: var(--text-sm); font-weight: 600; line-height: 1.5; white-space: nowrap; }
      .badge-success { background: var(--color-brand-soft); color: var(--color-brand-hover); border-color: transparent; }
      .badge-pending { background: var(--color-warning-soft); color: var(--color-warning); border-color: transparent; }
      .badge-failed { background: var(--color-danger-soft); color: var(--color-danger-text); border-color: transparent; }
      .badge-info { background: var(--color-info-soft); color: var(--color-info); border-color: transparent; }

      /* Feedback */
      .alert { padding: var(--space-3_5) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface); }
      .alert-error { background: var(--color-danger-soft); color: var(--color-danger-text); border-color: transparent; }
      .alert-success { background: var(--color-brand-soft); color: var(--color-brand-hover); border-color: transparent; }
      .empty { padding: var(--space-10) var(--space-4); text-align: center; color: var(--color-muted); }
      .empty .empty-title { color: var(--color-ink); font-weight: 700; font-size: var(--text-base); margin-bottom: var(--space-1); }

      /* Toast region (Wave 154 helper: window.mpToast) */
      .toast-region { position: fixed; right: var(--space-4); bottom: var(--space-4); z-index: var(--z-toast); display: grid; gap: var(--space-2); max-width: min(24rem, calc(100vw - 2rem)); }
      .toast { background: var(--color-surface-raised); color: var(--color-ink); border: 1px solid var(--color-border); border-left: 4px solid var(--color-brand); border-radius: var(--radius-md); box-shadow: var(--shadow-xl); padding: var(--space-3) var(--space-4); font-size: var(--text-body); animation: toast-in var(--motion-base) var(--ease-out); }
      .toast-error { border-left-color: var(--color-danger); }
      @keyframes toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

      /* Skeleton + spinner (static under reduced motion) */
      .skeleton { background: var(--color-surface-sunken); border-radius: var(--radius-md); min-height: 1rem; animation: skeleton-pulse 1.4s var(--ease-in-out) infinite; }
      @keyframes skeleton-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
      .spinner { width: 1rem; height: 1rem; border-radius: 50%; border: 2px solid var(--color-border); border-top-color: var(--color-brand); animation: spin 0.7s linear infinite; display: inline-block; }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* Dialog (native <dialog>, Wave 154) */
      dialog.mp-dialog { border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--color-surface-raised); color: var(--color-ink); box-shadow: var(--shadow-xl); padding: var(--space-6); max-width: min(28rem, calc(100vw - 2rem)); z-index: var(--z-modal); }
      dialog.mp-dialog::backdrop { background: var(--color-overlay); }

      /* Steps (checkout, onboarding) */
      .steps { display: flex; gap: var(--space-2); list-style: none; margin: 0 0 var(--space-5); padding: 0; }
      .steps li { display: flex; align-items: center; gap: var(--space-2); color: var(--color-muted); font-size: var(--text-base-sm); font-weight: 600; }
      .steps .step-dot { width: 1.625rem; height: 1.625rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--color-surface-sunken); color: var(--color-muted); font-size: var(--text-sm); flex: none; }
      .steps li[aria-current="step"] { color: var(--color-ink); }
      .steps li[aria-current="step"] .step-dot { background: var(--color-brand); color: var(--color-on-brand); }
      .steps li.done { color: var(--color-brand-hover); }
      .steps li.done .step-dot { background: var(--color-brand-soft); color: var(--color-brand-hover); }

      /* Copy field (recipient numbers, links, keys) */
      .copy-field { display: flex; align-items: stretch; gap: var(--space-2); }
      .copy-field .copy-value { flex: 1; display: flex; align-items: center; padding: var(--space-2_5) var(--space-3); background: var(--color-surface-sunken); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); font-family: var(--font-mono); font-size: var(--text-base); letter-spacing: 0.02em; overflow-x: auto; white-space: nowrap; }

      /* Sticky payer summary (checkout/pay, mobile) */
      .sticky-summary { position: sticky; bottom: 0; background: var(--color-surface); border-top: 1px solid var(--color-border); padding: var(--space-3) 0 calc(var(--space-3) + env(safe-area-inset-bottom)); margin-top: var(--space-4); }

      @media (max-width: 640px) {
        .container { padding: var(--space-4) var(--space-4) var(--space-8); }
        h1 { font-size: var(--text-2xl); }
        .table th, .table td { padding: var(--space-2); }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <div class="toast-region" id="toast-region" aria-live="polite"></div>
  </body>
</html>
