<?xml version="1.0" encoding="utf-8"?>
<!--
    MiraclePay v0.0.1
    Settings screen layout (clean-room original).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/serverUrlEdit"
            android:text="Server URL"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <EditText
            android:id="@+id/serverUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="url"
            android:hint="https://pay.example.com"
            android:importantForAutofill="yes"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/deviceKeyEdit"
            android:text="Device key"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <EditText
            android:id="@+id/deviceKeyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="password"
            android:hint="mp_live_..."
            android:importantForAutofill="yes"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/merchantLabelEdit"
            android:text="Merchant label"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <EditText
            android:id="@+id/merchantLabelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:hint="Main shop phone"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device ID"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <TextView
            android:id="@+id/deviceIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textIsSelectable="true"
            tools:text="00000000-0000-0000-0000-000000000000" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Button
            android:id="@+id/testButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Test connection" />

    </LinearLayout>

</ScrollView>
